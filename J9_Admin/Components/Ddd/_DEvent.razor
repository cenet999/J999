@page "/Ddd/DEvent"
@using System
@using System.IO
@using BootstrapBlazor.Components
@using Microsoft.AspNetCore.Hosting

<PageTitle>公告管理</PageTitle>

<NovaAdminTable TItem="DEvent" Context="item" PageSize="50" Title="公告管理" DialogClassName="modal-lg"
    OnQuery="OnQuery" InitQuery="InitQuery" OnEdit="OnEdit">

    <TableHeader>
        <th>公告名称</th>
        <th>发放数量</th>
        <th>公告时间</th>
        <th>展示结束时间</th>
        <th>公告状态</th>
        <th>排序</th>
        <th>图片</th>
    </TableHeader>
    <TableRow>
        <td>@item.Title</td>
        <td>@item.Count</td>
        <td>@item.StartTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
        <td>@item.EndTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
        <td>@item.IsEnabled</td>
        <td>@item.Sort</td>
        <td>
            @if (!string.IsNullOrEmpty(item.BannerUrl))
            {
                <img src="@item.BannerUrl" style="height: 50px; border-radius: 4px;" />
            }
        </td>
    </TableRow>
    <EditTemplate>
        <div class="row">
            <div class="form-group col-6">
                <label class="form-label">公告名称</label>
                <input @bind="item.Title" type="text" class="form-control" placeholder="" maxlength="255">
            </div>
            <div class="form-group col-12">
                <label class="form-label">公告描述</label>
                <textarea @bind="item.Summary" class="form-control" placeholder="" maxlength="65535"></textarea>
            </div>
            <div class="form-group col-6">
                <label class="form-label">发放数量</label>
                <input @bind="item.Count" type="number" class="form-control" placeholder="">
            </div>
            <div class="form-group col-6">
                <label class="form-label">开始时间</label>
                <input type="datetime-local" @bind="item.StartTime" class="form-control" />
            </div>
            <div class="form-group col-6">
                <label class="form-label">结束时间</label>
                <input type="datetime-local" @bind="item.EndTime" class="form-control" />
            </div>
            <div class="form-group col-6">
                <label class="form-label">公告类型</label>
                <input @bind="item.Type" type="text" class="form-control" placeholder="" maxlength="255">
            </div>
            <div class="form-group col-6">
                <label class="form-label">公告状态</label>
                <Switch @bind-Value="item.IsEnabled" OnColor="Color.Success" />
            </div>
            <div class="form-group col-6">
                <label class="form-label">排序</label>
                <input @bind="item.Sort" type="number" class="form-control" placeholder="">
            </div>
            <div class="form-group col-12">
                <label class="form-label">图片上传</label>
                <input @bind="item.BannerUrl" type="text" class="form-control mb-2" placeholder="" maxlength="65535">
                <CardUpload TValue="string" IsMultiple="false" IsDirectory="false" IsDisabled="false"
                    IsUploadButtonAtFirst="false" ShowProgress="true" ShowDeleteButton="true" ShowDownloadButton="false"
                    ShowZoomButton="true" OnChange="@OnCardUpload" DefaultFileList="@DefaultFormatFileList">
                </CardUpload>
            </div>
        </div>
    </EditTemplate> 
</NovaAdminTable>


@code {

    [Inject] IAggregateRootRepository<DEvent> repo { get; set; }
    [Inject] IWebHostEnvironment Env { get; set; }
    [Inject] IConfiguration Configuration { get; set; }

    private DEvent currentEditItem;
    private List<UploadFile> DefaultFormatFileList = [];
    private CancellationTokenSource? _token;
    private static long MaxFileLength => 10 * 1024 * 1024;

    async Task InitQuery(NovaAdminQueryInfo e)
    {
        e.Filters = [];
        await Task.Yield();
    }
    void OnQuery(NovaAdminQueryEventArgs<DEvent> e)
    {
        e.Select
            .WhereIf(!e.SearchText.IsNull(), a => a.Title.Contains(e.SearchText) || 
                a.Summary.Contains(e.SearchText) || 
                a.Type.Contains(e.SearchText) || 
                a.BannerUrl.Contains(e.SearchText) || 
                a.CreatedUserName.Contains(e.SearchText) || 
                a.ModifiedUserName.Contains(e.SearchText))
            .OrderByDescending(a => a.Id);
    }

    async Task OnEdit(DEvent item)
    {
        currentEditItem = item;
        if (item.DAgentId <= 0)
        {
            var firstAgent = await repo.Orm.Select<DAgent>().OrderBy(a => a.Id).FirstAsync();
            if (firstAgent != null)
            {
                item.DAgentId = firstAgent.Id;
            }
        }
        DefaultFormatFileList.Clear();
        if (!string.IsNullOrEmpty(item.BannerUrl))
        {
            DefaultFormatFileList.Add(new UploadFile { PrevUrl = item.BannerUrl });
        }
        await Task.Yield();
    }

    private async Task OnCardUpload(UploadFile file)
    {
        if (file is { File: not null })
        {
            if (file.Size > MaxFileLength)
            {
                await MessageService.Error("文件大于 10M 请重新选择文件上传");
                file.Code = 1;
                file.Error = "文件大于 10M 请重新选择文件上传";
                return;
            }

            await SaveToFile(file);
            if (currentEditItem != null)
            {
                currentEditItem.BannerUrl = $"{Configuration["APIDomain"]}/uploads/{file.FileName}";
            }

            await MessageService.Success($"文件上传 {file.FileName} 文件保存成功");
            StateHasChanged();
        }
    }

    private async Task SaveToFile(UploadFile file)
    {
        var uploaderFolder = Path.Combine(Env.WebRootPath, "uploads");
        if (!Directory.Exists(uploaderFolder))
        {
            Directory.CreateDirectory(uploaderFolder);
        }

        file.FileName = $"{DateTimeOffset.Now:yyyyMMddHHmmss}_{Path.GetFileName(file.OriginFileName)}";
        var fileName = Path.Combine(uploaderFolder, file.FileName);

        _token ??= new CancellationTokenSource();
        try
        {
            var ret = await file.SaveToFileAsync(fileName, MaxFileLength, token: _token.Token);
            if (ret)
            {
                file.PrevUrl = $"/uploads/{file.FileName}";
            }
            else
            {
                file.Code = 1;
                file.Error = "文件保存失败";
                await MessageService.Error("文件保存失败");
            }
        }
        catch (OperationCanceledException)
        {
        }
    }
}
