@page "/Ddd/DGamePlatform"
@layout LayoutAdmin
@inject IFreeSql FreeSql
@inject IToastService ToastService

<PageTitle>游戏平台</PageTitle>

<div class="flex flex-col flex-1 min-h-0 overflow-hidden">
    <CrudTable TItem="DGamePlatform"
               Title="游戏平台"
               PageSize="50"
               InitQuery="InitQuery"
               OnQuery="HandleQuery"
               OnEdit="HandleEdit"
               OnRemoving="HandleRemoving"
               DialogContentSize="CrudDialogContentSize.Lg">
        <Columns>
            <DataTableColumn TData="CrudGridRow<DGamePlatform>"
                             TValue="long"
                             Property="@(row => row.Item.Id)"
                             Header="ID"
                             Sortable="false"
                             Width="180px" />
            <DataTableColumn TData="CrudGridRow<DGamePlatform>"
                             TValue="string"
                             Property="@(row => row.Item.Name)"
                             Header="显示名称"
                             Sortable="false" />
            <DataTableColumn TData="CrudGridRow<DGamePlatform>"
                             TValue="bool"
                             Property="@(row => row.Item.IsEnabled)"
                             Header="平台状态"
                             Sortable="false"
                             Width="96px">
                <CellTemplate Context="row">
                    @(row.Item.IsEnabled ? "启用" : "停用")
                </CellTemplate>
            </DataTableColumn>
            <DataTableColumn TData="CrudGridRow<DGamePlatform>"
                             TValue="int"
                             Property="@(row => row.Item.Sort)"
                             Header="排序"
                             Sortable="false"
                             Width="72px" />
            <DataTableColumn TData="CrudGridRow<DGamePlatform>"
                             TValue="string"
                             Property="@(_ => string.Empty)"
                             Header="创建时间"
                             Sortable="false"
                             Width="200px">
                <CellTemplate Context="row">
                    @(row.Item.CreatedTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")
                </CellTemplate>
            </DataTableColumn>
        </Columns>
        <EditTemplate Context="item">
            <div class="space-y-2">
                <Label For="platform-name">显示名称</Label>
                <Input id="platform-name" Class="w-full" MaxLength="255" @bind-Value="item.Name" />
            </div>
            <div class="flex items-center gap-2">
                <Checkbox @bind-Checked="item.IsEnabled" Id="platform-enabled" />
                <Label for="platform-enabled">平台状态</Label>
            </div>
            <div class="space-y-2">
                <Label For="platform-sort">排序</Label>
                <Input id="platform-sort" Type="InputType.Number" Class="w-full" Value="@item.Sort.ToString()" ValueChanged="@(v => item.Sort = int.TryParse(v, out var n) ? n : 0)" />
            </div>
        </EditTemplate>
    </CrudTable>
</div>

@code {
    private Task InitQuery(CrudQueryInfo e)
    {
        e.Filters = [];
        return Task.CompletedTask;
    }

    private void HandleQuery(CrudQueryEventArgs<DGamePlatform> e)
    {
        e.Select!
            .WhereIf(!e.SearchText.IsNull(), a => a.Name.Contains(e.SearchText!) ||
                a.CreatedUserName.Contains(e.SearchText!) ||
                a.ModifiedUserName.Contains(e.SearchText!))
            .OrderByDescending(a => a.Id);
    }

    private Task HandleEdit(DGamePlatform item) => Task.CompletedTask;

    private async Task HandleRemoving(CrudConfirmEventArgs<DGamePlatform> e)
    {
        bool hasGames = await FreeSql.Select<DGame>()
            .Where(a => a.DGamePlatformId == e.Item.Id)
            .AnyAsync();

        if (!hasGames)
        {
            return;
        }

        ToastService.Error("删除失败", "不能删除：所选平台下仍存在游戏，请先清空游戏");
        e.Cancel = true;
    }
}
