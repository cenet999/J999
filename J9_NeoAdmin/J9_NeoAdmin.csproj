<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>J9_NeoAdmin</AssemblyName>
		<RootNamespace>J9_NeoAdmin</RootNamespace>
		<NoWarn>1701;1702;CS1573;CS8600;CS8601;CS8602;CS8603;CS8604;CS8605;CS8618;CS8619;CS8620;CS8622;CS8625;CS8629;CS8714;CS1591</NoWarn>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<DefaultItemExcludes>$(DefaultItemExcludes);**/buyu.db;**/buyu.db-*;**/wwwroot/uploads/**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Condition="Exists('../../NeoAdminProject/NeoAdmin.Blazor/NeoAdmin.Blazor.csproj')"
		                  Include="../../NeoAdminProject/NeoAdmin.Blazor/NeoAdmin.Blazor.csproj" />
		<PackageReference Condition="!Exists('../../NeoAdminProject/NeoAdmin.Blazor/NeoAdmin.Blazor.csproj')"
		                  Include="NeoAdmin.Blazor" Version="1.0.22" />
		<PackageReference Include="NeoUI.Blazor" Version="4.1.7" />

		<PackageReference Include="FreeScheduler" Version="2.1.4" />
		<PackageReference Include="FreeSql" Version="3.5.304" />
		<PackageReference Include="FreeSql.Provider.SqliteCore" Version="3.5.304" />
		<PackageReference Include="FreeSql.Provider.PostgreSQL" Version="3.5.304" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
		<PackageReference Include="NCrontab" Version="3.4.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Yitter.IdGenerator" Version="1.0.14" />

		<PackageReference Include="Rougamo.Fody" Version="5.0.2" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.0" />
		<PackageReference Include="RestSharp" Version="112.1.0" />
		<PackageReference Include="TelegramBotBase" Version="6.6.3" />
		<PackageReference Include="Serilog" Version="4.2.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
		<PackageReference Include="NPinyin" Version="0.2.6321.26573" />
	</ItemGroup>

	<ItemGroup>
		<Watch Remove="**/buyu.db" />
		<Watch Remove="**/buyu.db-*" />
		<Watch Remove="**/wwwroot/uploads/**" />
		<Watch Remove="**/node_modules/**" />
		<Content Update="wwwroot/uploads/**" Watch="false" />
		<None Update="buyu.db" Watch="false" />
		<None Update="buyu.db-*" Watch="false" />
	</ItemGroup>

	<ItemGroup>
		<Content Remove="package.json" />
		<Content Remove="package-lock.json" />
		<Content Remove="tailwind.config.js" />
	</ItemGroup>

	<!-- Docker / CI 发布传 -p:SkipTailwindBuild=true，且构建上下文不含 package.json，仅使用已提交的 j9-admin.css -->
	<Target Name="NpmInstall" BeforeTargets="BuildTailwindCss"
	        Condition="Exists('$(ProjectDir)package.json') AND '$(SkipTailwindBuild)' != 'true'">
		<Exec Command="npm install" WorkingDirectory="$(ProjectDir)" />
	</Target>

	<Target Name="BuildTailwindCss" BeforeTargets="Build"
	        Condition="Exists('$(ProjectDir)package.json') AND '$(SkipTailwindBuild)' != 'true'">
		<Exec Command="npm run build:css" WorkingDirectory="$(ProjectDir)" />
	</Target>

</Project>
